---
// About Component
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { experienceYears } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="about" class="about-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t('about.title')}</h2>
      <div class="section-line"></div>
    </div>

    <div class="about-content">
      <div class="about-card glass">
        <h3 class="card-title">{t('about.profileTitle')}</h3>
        <p set:html={t('about.p1')} />
        <p style="margin-top: var(--space-4);" set:html={t('about.p2')} />
        <p style="margin-top: var(--space-4);" set:html={t('about.p3')} />
      </div>

      <div class="stats-grid">
        <div class="stat-card glass">
          <span class="stat-number text-gradient">+{experienceYears}</span>
          <span class="stat-label" set:html={t('about.years')} />
        </div>
        <div class="stat-card glass">
          <span class="stat-number text-gradient">+20</span>
          <span class="stat-label" set:html={t('about.projects')} />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-header {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .section-title {
    font-size: 2.5rem;
    letter-spacing: -0.5px;
  }

  .section-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border-light), transparent);
  }

  .about-content {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: var(--space-8);
  }

  .about-card {
    padding: var(--space-8);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    border: 1px solid var(--card-border);
  }

  .card-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-6);
    color: var(--text-primary);
  }

  strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .stat-card {
    padding: var(--space-8);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    transition: all var(--transition-fast);
  }

  .stat-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-primary);
    box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.12);
  }

  :global(.dark) .stat-card:hover {
    box-shadow: 0 10px 25px -5px rgba(59, 130, 246, 0.2);
  }

  .stat-number {
    font-size: 3.5rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 0.95rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
  }

  @media (max-width: 992px) {
    .about-content {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 500px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
