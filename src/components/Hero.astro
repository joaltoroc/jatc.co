---
// Hero Component
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import profileImage from '../assets/jatc.webp';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero-section" id="home">
  <div class="container hero-content">
    <div class="hero-text">
      <div class="badge glass">{t('hero.badge')}</div>
      <h1 class="hero-title">
        {t('hero.greeting')}
        <span class="text-gradient">John Toro</span><br />
        {t('hero.building')}<br />
        {t('hero.secure')}
      </h1>
      <p class="hero-description" set:html={t('hero.desc')} />

      <div class="hero-actions">
        <a href="#contact" class="btn-primary">{t('hero.contact')}</a>
        <button id="hero-cv-btn" class="btn-secondary">{t('hero.cv')}</button>
      </div>
    </div>

    <div class="hero-image-container">
      <div class="glow"></div>
      <div class="image-wrapper">
        <Image
          src={profileImage}
          alt="John Alexander Toro Cortés - Team Lead & Senior Full Stack Engineer"
          width={400}
          height={400}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="hero-profile-img"
        />
      </div>

      <!-- CLI Terminal Interactive overlay -->
      <div class="cli-container hero-cli glass" id="hero-cli-container">
        <div class="cli-header">
          <span class="cli-dot red"></span>
          <span class="cli-dot yellow"></span>
          <span class="cli-dot green"></span>
          <span class="cli-title">john@jatc: ~</span>
        </div>
        <div class="cli-body" id="hero-cli-body">
          <div id="cli-history">
            <div class="cli-line"><span class="cli-prompt">$</span> whoami</div>
            <div class="cli-output">John Toro | Development Manager</div>
            <div class="cli-line">
              <span class="cli-prompt">$</span> security --check
            </div>
            <div class="cli-output success">✓ OWASP & DevSecOps: Active</div>
            <div class="cli-output success">✓ Cloud Infra: Active</div>
            <div class="cli-output success">✓ Code Quality: Active</div>
          </div>
          <form id="cli-form" class="cli-input-line" autocomplete="off">
            <span class="cli-prompt">$</span>
            <input
              type="text"
              id="cli-input"
              class="cli-input-field"
              placeholder="type 'help'..."
              spellcheck="false"
              aria-label="Terminal Command Input"
            />
          </form>
        </div>
      </div>
    </div>

    <!-- Print-only contact info for resume generation -->
    <div class="print-only-block print-contact-info">
      <div class="print-contact-grid">
        <div class="print-contact-item">
          <svg
            class="print-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
            ></path><polyline points="22,6 12,13 2,6"></polyline></svg
          >
          <span
            class="hero-secure-data"
            data-type="email"
            data-value="am9hbHRvcm9jQGphdGMuY28=">joaltoroc [at] jatc.co</span
          >
        </div>
        <div class="print-contact-item">
          <svg
            class="print-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path></svg
          >
          <span
            class="hero-secure-data"
            data-type="text"
            data-value="KzU3IDMwMSA3MjIgODY0Mg==">+57 301 [at]...</span
          >
        </div>
        <div class="print-contact-item">
          <svg
            class="print-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
            ></path><rect x="2" y="9" width="4" height="12"></rect><circle
              cx="4"
              cy="4"
              r="2"></circle></svg
          >
          <span
            class="hero-secure-data"
            data-type="link"
            data-value="aHR0cHM6Ly93d3cubGlua2VkaW4uY29tL2luL2pvYWx0b3JvYw=="
            >linkedin.com/in/joaltoroc</span
          >
        </div>
        <div class="print-contact-item">
          <svg
            class="print-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
            ></path></svg
          >
          <span
            class="hero-secure-data"
            data-type="link"
            data-value="aHR0cHM6Ly93d3cuZ2l0aHViLmNvbS9qb2FsdG9yb2M="
            >github.com/joaltoroc</span
          >
        </div>
        <div class="print-contact-item">
          <svg
            class="print-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="10"></circle><line
              x1="2"
              y1="12"
              x2="22"
              y2="12"></line><path
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path></svg
          >
          <span
            class="hero-secure-data"
            data-type="link"
            data-value="aHR0cHM6Ly93d3cuamF0Yy5jbw==">jatc.co</span
          >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 70px; /* Offset for fixed header */
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-primary);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 3.5rem;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -1px;
  }

  .hero-description {
    font-size: 1.1rem;
    max-width: 500px;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
  }

  /* Image styling */
  .hero-image-container {
    position: relative;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    min-height: 440px;
  }

  .glow {
    position: absolute;
    top: 5%;
    left: 10%;
    width: 360px;
    height: 360px;
    background: radial-gradient(
      circle,
      var(--accent-primary, #6366f1) 0%,
      var(--accent-secondary, #a855f7) 60%,
      transparent 100%
    );
    filter: blur(90px);
    opacity: 0.35;
    border-radius: 50%;
    z-index: 0;
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }

  .hero-image-container:hover .glow {
    opacity: 0.55;
    transform: scale(1.05);
  }

  .image-wrapper {
    position: relative;
    z-index: 1;
    width: 400px;
    height: 440px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .hero-profile-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: top center;
    filter: drop-shadow(0 15px 30px rgba(0, 0, 0, 0.22));
    -webkit-mask-image: linear-gradient(to bottom, black 80%, transparent 98%);
    mask-image: linear-gradient(to bottom, black 80%, transparent 98%);
    transition:
      filter 0.4s ease,
      transform 0.4s ease;
  }

  .image-wrapper:hover .hero-profile-img {
    filter: drop-shadow(0 22px 36px rgba(99, 102, 241, 0.35));
    transform: translateY(-4px) scale(1.02);
  }

  .hero-cli {
    position: absolute;
    bottom: -10px;
    right: -70px;
    z-index: 10;
    max-width: 290px !important;
    font-size: 0.8rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
  }

  .hero-cli .cli-body {
    min-height: 140px;
    max-height: 220px;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
  }

  .cli-input-line {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .cli-input-field {
    background: transparent;
    border: none;
    outline: none;
    color: var(--accent-primary, #6366f1);
    font-family: inherit;
    font-size: inherit;
    width: 100%;
    caret-color: var(--accent-primary, #6366f1);
  }

  .cli-input-field::placeholder {
    color: var(--text-secondary, #a1a1aa);
    opacity: 0.6;
  }

  @media (max-width: 992px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 3rem;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .hero-description {
      margin: 0 auto 2rem auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-image-container {
      flex-direction: column;
      gap: 2rem;
      min-height: auto;
      justify-content: center;
    }

    .image-wrapper {
      width: 300px;
      height: 330px;
    }

    .hero-cli {
      position: relative;
      bottom: auto;
      right: auto;
      margin: 0 auto;
      max-width: 100% !important;
    }
  }

  @media print {
    .hero-cli {
      display: none !important;
    }
  }

  .print-only-block {
    display: none;
  }

  @media print {
    .print-only-block {
      display: block !important;
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px dashed #ccc !important;
    }

    .print-contact-grid {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 0.75rem 1.5rem !important;
    }

    .print-contact-item {
      display: flex !important;
      align-items: center !important;
      gap: 0.5rem !important;
      font-size: 0.9rem !important;
      color: #333 !important;
    }

    .print-icon {
      color: #000 !important;
      flex-shrink: 0;
    }
  }
</style>

<script>
  const initHero = () => {
    const printBtn = document.getElementById('hero-cv-btn');
    if (printBtn) {
      printBtn.addEventListener('click', () => {
        window.print();
      });
    }

    const decodeHeroData = () => {
      const secureSpans = document.querySelectorAll('.hero-secure-data');
      secureSpans.forEach((span) => {
        const encoded = span.getAttribute('data-value');
        const type = span.getAttribute('data-type');
        if (encoded) {
          try {
            const decoded = atob(encoded);
            if (type === 'link') {
              const anchor = document.createElement('a');
              anchor.href = decoded;
              anchor.target = '_blank';
              anchor.rel = 'noopener noreferrer';
              anchor.style.color = 'inherit';
              anchor.style.textDecoration = 'none';
              anchor.textContent = decoded;
              span.replaceChildren(anchor);
            } else {
              span.textContent = decoded;
            }
          } catch {
            // Fault tolerance against malformed base64
          }
        }
      });
    };
    window.addEventListener('beforeprint', decodeHeroData);
    decodeHeroData();

    // Interactive Terminal CLI Logic
    const cliForm = document.getElementById(
      'cli-form'
    ) as HTMLFormElement | null;
    const cliInput = document.getElementById(
      'cli-input'
    ) as HTMLInputElement | null;
    const cliHistory = document.getElementById('cli-history');
    const cliBody = document.getElementById('hero-cli-body');

    if (cliForm && cliInput && cliHistory && cliBody) {
      const commandHistoryList: string[] = [];
      let historyIndex = -1;

      const appendLine = (
        text: string,
        isCommand = false,
        isSuccess = false
      ) => {
        const div = document.createElement('div');
        if (isCommand) {
          div.className = 'cli-line';
          div.innerHTML = `<span class="cli-prompt">$</span> ${text}`;
        } else {
          div.className = `cli-output ${isSuccess ? 'success' : ''}`;
          div.textContent = text;
        }
        cliHistory.appendChild(div);
        cliBody.scrollTop = cliBody.scrollHeight;
      };

      const handleCommand = (cmdStr: string) => {
        const trimmed = cmdStr.trim().toLowerCase();
        if (!trimmed) return;

        appendLine(trimmed, true);
        commandHistoryList.push(trimmed);
        historyIndex = commandHistoryList.length;

        switch (trimmed) {
          case 'help':
            appendLine('Available commands:');
            appendLine('  whoami     - Professional identity');
            appendLine('  skills     - Core tech stack');
            appendLine('  experience - Career history');
            appendLine('  projects   - Featured work');
            appendLine('  contact    - Socials & email');
            appendLine('  cv         - Download / print resume');
            appendLine('  theme      - Toggle dark/light theme');
            appendLine('  version    - Show portfolio version');
            appendLine('  matrix     - 010101 Rain effect');
            appendLine('  clear      - Clear console');
            break;
          case 'version':
          case 'ver':
            appendLine(
              'JATC Portfolio v0.2.0 (Astro 7.2.4 + TypeScript)',
              false,
              true
            );
            break;
          case 'whoami':
            appendLine(
              'John Toro | Development Manager & Technical Lead (+18 yrs exp)'
            );
            break;
          case 'skills':
            appendLine(
              'Golang · C#/.NET · TypeScript · Azure/AWS · DevSecOps · Clean Arch'
            );
            break;
          case 'experience':
            appendLine(
              'Gerente de Desarrollo (2026-Pres), Quetzal (2024-2026), Zulu Tech (2022-2023)...'
            );
            document
              .getElementById('experience')
              ?.scrollIntoView({ behavior: 'smooth' });
            break;
          case 'projects':
            appendLine('GitHub Helpers (Live API), JATC.co Portfolio');
            document
              .getElementById('projects')
              ?.scrollIntoView({ behavior: 'smooth' });
            break;
          case 'contact':
            appendLine(
              'Email: joaltoroc [at] jatc.co | GitHub: github.com/joaltoroc'
            );
            document
              .getElementById('contact')
              ?.scrollIntoView({ behavior: 'smooth' });
            break;
          case 'cv':
            appendLine('Opening print view for CV generation...', false, true);
            window.print();
            break;
          case 'theme':
            const isDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            appendLine(
              `Switched to ${isDark ? 'Dark' : 'Light'} mode`,
              false,
              true
            );
            break;
          case 'matrix':
            appendLine(
              '01001010 01000001 01010100 01000011 00100001',
              false,
              true
            );
            break;
          case 'clear':
            cliHistory.replaceChildren();
            break;
          case 'sudo':
            appendLine('[sudo] permission denied: John is already root 🛡️');
            break;
          default:
            appendLine(
              `command not found: ${trimmed}. Type 'help' for options.`
            );
        }
      };

      cliForm.addEventListener('submit', (e) => {
        e.preventDefault();
        handleCommand(cliInput.value);
        cliInput.value = '';
      });

      cliInput.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowUp') {
          if (historyIndex > 0) {
            historyIndex--;
            cliInput.value = commandHistoryList[historyIndex] || '';
          }
          e.preventDefault();
        } else if (e.key === 'ArrowDown') {
          if (historyIndex < commandHistoryList.length - 1) {
            historyIndex++;
            cliInput.value = commandHistoryList[historyIndex] || '';
          } else {
            historyIndex = commandHistoryList.length;
            cliInput.value = '';
          }
          e.preventDefault();
        }
      });
    }
  };

  document.addEventListener('DOMContentLoaded', initHero);
  document.addEventListener('astro:page-load', initHero);
</script>
