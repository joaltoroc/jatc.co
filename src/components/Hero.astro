---
// Hero Component
import { Image } from 'astro:assets';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import profileImage from '../assets/jatc.webp';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero-section" id="home">
  <div class="container hero-content">
    <div class="hero-text">
      <div class="badge glass">{t('hero.badge')}</div>
      <h1 class="hero-title">
        {t('hero.greeting')}
        <span class="text-gradient">John Toro</span><br />
        {t('hero.building')}<br />
        {t('hero.secure')}
      </h1>
      <p class="hero-description" set:html={t('hero.desc')} />

      <div class="hero-actions">
        <a href="#contact" class="btn-primary">{t('hero.contact')}</a>
        <button onclick="window.print()" class="btn-secondary"
          >{t('hero.cv')}</button
        >
      </div>
    </div>

    <div class="hero-image-container">
      <div class="glow"></div>
      <div class="image-wrapper">
        <Image
          src={profileImage}
          alt="John Alexander Toro Cortés - Team Lead & Senior Full Stack Engineer"
          width={400}
          height={400}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          style="width: 100%; height: 100%; object-fit: cover;"
        />
      </div>

      <!-- CLI Terminal HUD overlay -->
      <div class="cli-container hero-cli glass">
        <div class="cli-header">
          <span class="cli-dot red"></span>
          <span class="cli-dot yellow"></span>
          <span class="cli-dot green"></span>
          <span class="cli-title">john@jatc: ~</span>
        </div>
        <div class="cli-body">
          <div class="cli-line"><span class="cli-prompt">$</span> whoami</div>
          <div class="cli-output">John Toro | Technical Lead</div>
          <div class="cli-line">
            <span class="cli-prompt">$</span> security --check
          </div>
          <div class="cli-output success">✓ OWASP & DevSecOps: Active</div>
          <div class="cli-output success">✓ Cloud Infra: Active</div>
          <div class="cli-output success">✓ Code Quality: Active</div>
          <div class="cli-line">
            <span class="cli-prompt">$</span>
            <span class="cli-cursor">_</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Print-only contact info for resume generation -->
    <div class="print-only-block print-contact-info">
      <div class="print-contact-grid">
        <div class="print-contact-item">
          <svg
            class="print-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
            ></path><polyline points="22,6 12,13 2,6"></polyline></svg
          >
          <span
            class="hero-secure-data"
            data-type="email"
            data-value="am9hbHRvcm9jQGphdGMuY28=">joaltoroc [at] jatc.co</span
          >
        </div>
        <div class="print-contact-item">
          <svg
            class="print-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
            ></path></svg
          >
          <span
            class="hero-secure-data"
            data-type="text"
            data-value="KzU3IDMwMSA3MjIgODY0Mg==">+57 301 [at]...</span
          >
        </div>
        <div class="print-contact-item">
          <svg
            class="print-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
            ></path><rect x="2" y="9" width="4" height="12"></rect><circle
              cx="4"
              cy="4"
              r="2"></circle></svg
          >
          <span
            class="hero-secure-data"
            data-type="link"
            data-value="aHR0cHM6Ly93d3cubGlua2VkaW4uY29tL2luL2pvYWx0b3JvYw=="
            >linkedin.com/in/joaltoroc</span
          >
        </div>
        <div class="print-contact-item">
          <svg
            class="print-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
            ></path></svg
          >
          <span
            class="hero-secure-data"
            data-type="link"
            data-value="aHR0cHM6Ly93d3cuZ2l0aHViLmNvbS9qb2FsdG9yb2M="
            >github.com/joaltoroc</span
          >
        </div>
        <div class="print-contact-item">
          <svg
            class="print-icon"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><circle cx="12" cy="12" r="10"></circle><line
              x1="2"
              y1="12"
              x2="22"
              y2="12"></line><path
              d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
            ></path></svg
          >
          <span
            class="hero-secure-data"
            data-type="link"
            data-value="aHR0cHM6Ly93d3cuamF0Yy5jbw==">jatc.co</span
          >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 70px; /* Offset for fixed header */
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-primary);
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 3.5rem;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    letter-spacing: -1px;
  }

  .hero-description {
    font-size: 1.1rem;
    max-width: 500px;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
  }

  /* Image styling */
  .hero-image-container {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .glow {
    position: absolute;
    width: 300px;
    height: 300px;
    background: var(--accent-secondary);
    filter: blur(100px);
    opacity: 0.4;
    border-radius: 50%;
    z-index: 0;
  }

  .image-wrapper {
    position: relative;
    z-index: 1;
    width: 350px;
    height: 350px;
    border-radius: 2rem;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    border: 1px solid var(--border-light);
  }

  .hero-cli {
    position: absolute;
    bottom: -30px;
    right: -40px;
    z-index: 10;
    max-width: 300px !important;
    font-size: 0.8rem;
  }

  .hero-cli .cli-body {
    min-height: 140px;
    padding: 1rem;
  }

  @media (max-width: 992px) {
    .hero-content {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 3rem;
    }

    .hero-title {
      font-size: 2.5rem;
    }

    .hero-description {
      margin: 0 auto 2rem auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-image-container {
      flex-direction: column;
      gap: 2rem;
    }

    .image-wrapper {
      width: 280px;
      height: 280px;
    }

    .hero-cli {
      position: relative;
      bottom: auto;
      right: auto;
      margin: 0 auto;
      max-width: 100% !important;
    }
  }

  @media print {
    .hero-cli {
      display: none !important;
    }
  }

  .print-only-block {
    display: none;
  }

  @media print {
    .print-only-block {
      display: block !important;
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px dashed #ccc !important;
    }

    .print-contact-grid {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 0.75rem 1.5rem !important;
    }

    .print-contact-item {
      display: flex !important;
      align-items: center !important;
      gap: 0.5rem !important;
      font-size: 0.9rem !important;
      color: #333 !important;
    }

    .print-icon {
      color: #000 !important;
      flex-shrink: 0;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const decodeHeroData = () => {
      const secureSpans = document.querySelectorAll('.hero-secure-data');
      secureSpans.forEach((span) => {
        const encoded = span.getAttribute('data-value');
        const type = span.getAttribute('data-type');
        if (encoded) {
          const decoded = atob(encoded);
          if (type === 'link') {
            span.innerHTML = `<a href="${decoded}" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;">${decoded}</a>`;
          } else {
            span.textContent = decoded;
          }
        }
      });
    };
    window.addEventListener('beforeprint', decodeHeroData);
    decodeHeroData();
  });
</script>
