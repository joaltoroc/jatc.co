---
// Header Component
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import ThemeToggle from './ThemeToggle.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEn = lang === 'en';
---

<header class="header glass">
  <div class="container header-content">
    <div class="logo">
      <a href={isEn ? '/en/' : '/'}>JATC</a>
    </div>

    <nav class="desktop-nav">
      <ul>
        <li><a href="#about">{t('nav.about')}</a></li>
        <li><a href="#experience">{t('nav.experience')}</a></li>
        <li><a href="#projects">{t('nav.projects')}</a></li>
        <li><a href="#education">{t('nav.education')}</a></li>
        <li><a href="#courses">{t('nav.courses')}</a></li>
        <li><a href="#skills">{t('nav.skills')}</a></li>
        <li><a href="#contact">{t('nav.contact')}</a></li>
      </ul>
    </nav>

    <div class="actions">
      <ThemeToggle />
      <div class="lang-selector">
        <a
          href="/"
          class={!isEn ? 'active-lang' : ''}
          aria-label={t('lang.es.label')}>ES</a
        >
        <span class="lang-divider" aria-hidden="true">|</span>
        <a
          href="/en/"
          class={isEn ? 'active-lang' : ''}
          aria-label={t('lang.en.label')}>EN</a
        >
      </div>
      <button
        class="mobile-menu-btn"
        id="mobile-menu-btn"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <svg
          class="hamburger-icon"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg
          class="close-icon"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="display: none;"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div class="mobile-menu-drawer" id="mobile-menu-drawer">
    <nav class="mobile-nav">
      <ul>
        <li><a href="#about" class="mobile-nav-link">{t('nav.about')}</a></li>
        <li>
          <a href="#experience" class="mobile-nav-link">{t('nav.experience')}</a
          >
        </li>
        <li>
          <a href="#projects" class="mobile-nav-link">{t('nav.projects')}</a>
        </li>
        <li>
          <a href="#education" class="mobile-nav-link">{t('nav.education')}</a>
        </li>
        <li>
          <a href="#courses" class="mobile-nav-link">{t('nav.courses')}</a>
        </li>
        <li><a href="#skills" class="mobile-nav-link">{t('nav.skills')}</a></li>
        <li>
          <a href="#contact" class="mobile-nav-link">{t('nav.contact')}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 100;
    border-bottom: 1px solid var(--border-light);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  .logo a {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    transition: opacity var(--transition-fast);
  }

  .logo a:active {
    opacity: 0.8;
  }

  .desktop-nav ul {
    display: flex;
    gap: 2rem;
  }

  .desktop-nav a {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .desktop-nav a:hover {
    color: var(--text-primary);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .lang-selector {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .lang-selector a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
    padding: 0.5rem; /* Aumenta el touch target vertical y horizontal */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    border-radius: 0.25rem;
  }

  .lang-selector a:hover {
    color: var(--text-primary);
    background: var(--surface-light);
  }

  .lang-selector a.active-lang {
    color: var(--text-primary);
    font-weight: 700;
    background: var(--surface-light);
  }

  .lang-divider {
    color: var(--border-light);
    user-select: none;
  }

  .mobile-menu-btn {
    display: none;
    color: var(--text-primary);
    position: relative;
    z-index: 102;
    padding: 10px; /* Aumenta el área táctil física sin mover el botón */
    margin: -10px; /* Compensa el padding */
  }

  .mobile-menu-btn.is-active .hamburger-icon {
    display: none !important;
  }

  .mobile-menu-btn.is-active .close-icon {
    display: block !important;
  }

  /* Mobile Menu Drawer */
  .mobile-menu-drawer {
    position: fixed;
    top: 70px;
    left: 0;
    width: 100%;
    height: calc(100vh - 70px);
    background: var(--glass-bg);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 99;
    transform: translateY(-100%);
    opacity: 0;
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.3s ease;
    pointer-events: none;
  }

  .mobile-menu-drawer.is-active {
    transform: translateY(0);
    opacity: 1;
    pointer-events: all;
  }

  .mobile-nav ul {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  .mobile-nav a {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition:
      color var(--transition-fast),
      transform var(--transition-fast);
    display: inline-block;
  }

  .mobile-nav a:hover {
    color: var(--text-primary);
    transform: scale(1.05);
  }

  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }

    .mobile-menu-btn {
      display: block;
    }
  }
</style>

<script>
  function initMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-menu-drawer');
    const links = document.querySelectorAll('.mobile-nav-link');

    if (!btn || !drawer) return;

    const toggleMenu = () => {
      const isOpen = btn.classList.toggle('is-active');
      drawer.classList.toggle('is-active', isOpen);
      btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      document.body.style.overflow = isOpen ? 'hidden' : '';
    };

    const closeMenu = () => {
      btn.classList.remove('is-active');
      drawer.classList.remove('is-active');
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    btn.addEventListener('click', toggleMenu);

    links.forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    // Close on resize if switching to desktop
    window.addEventListener('resize', () => {
      if (window.innerWidth > 768) {
        closeMenu();
      }
    });
  }

  // Initialize
  initMobileMenu();

  // Re-initialize after view transitions
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
