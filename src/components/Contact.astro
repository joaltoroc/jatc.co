---
// Contact Component
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="contact-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t('contact.title')}</h2>
      <div class="section-line"></div>
    </div>
    
    <div class="contact-content">
      <div class="contact-info glass">
        <h3 class="info-title">{t('contact.subtitle')}</h3>
        <p class="info-desc">
          {t('contact.desc')}
        </p>
        
        <div class="contact-methods">
          <a href="#" class="method-item email-link" data-email="am9hbHRvcm9jQGphdGMuY28=">
            <div class="icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <span><span class="email-text" data-original-text="{t('contact.email')}">{t('contact.email')}</span> <span class="print-only print-email"></span></span>
          </a>
          
          <a href="https://linkedin.com/in/joaltoroc" target="_blank" rel="noopener noreferrer" class="method-item">
            <div class="icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            </div>
            <span>LinkedIn <span class="print-only">https://linkedin.com/in/joaltoroc</span> </span>
          </a>
          
          <a href="https://github.com/joaltoroc" target="_blank" rel="noopener noreferrer" class="method-item">
            <div class="icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            </div>
            <span>GitHub <span class="print-only">https://github.com/joaltoroc</span> </span>
          </a>

          <div class="method-item print-only">
            <div class="icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <span>{t('contact.phone')} <span class="print-only">+573017228642</span></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 2.5rem;
    letter-spacing: -0.5px;
  }

  .section-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border-light), transparent);
  }

  .contact-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .contact-info {
    padding: 3rem;
    border-radius: 1.5rem;
    text-align: center;
  }

  .info-title {
    font-size: 2rem;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .info-desc {
    margin-bottom: 3rem;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    align-items: left;
    gap: 1.5rem;
  }

  .method-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.1rem;
    font-weight: 500;
    width: fit-content;
    text-align: left;
  }

  .method-item:hover {
    color: var(--text-primary);
  }

  .method-item .icon {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 48px;
    height: 48px;
    background: var(--surface-light);
    border-radius: 12px;
    color: var(--accent-primary);
    transition: all var(--transition-fast);
  }

  .method-item:hover .icon {
    background: var(--accent-primary);
    color: var(--text-primary);
  }

  .print-only {
    display: none;
  }

  @media print {
    .print-only {
      display: flex !important;
    }
  }

  @media (max-width: 992px) {
    .contact-info {
      padding: 2rem;
    }
  }
</style>

<script>
  // Obfuscate email to prevent spam bots from scraping it
  document.addEventListener('DOMContentLoaded', () => {
    const emailLinks = document.querySelectorAll('.email-link');
    
    emailLinks.forEach(link => {
      let isDecoded = false;
      
      // Decode the base64 email
      const decodeEmail = () => {
        if (isDecoded) return;
        
        const encoded = link.getAttribute('data-email');
        if (encoded) {
          const decoded = atob(encoded);
          link.setAttribute('href', `mailto:${decoded}`);
          
          // Update the text content if you want to show the email on hover
          const textSpan = link.querySelector('.email-text');
          if (textSpan && textSpan.textContent === textSpan.getAttribute('data-original-text')) {
            textSpan.textContent = decoded;
          }

          // Securely inject the email for printing
          const printSpan = link.querySelector('.print-email');
          if (printSpan) {
            printSpan.textContent = decoded;
          }
          
          isDecoded = true;
        }
      };

      // Decode on interaction
      link.addEventListener('mouseenter', decodeEmail);
      link.addEventListener('click', decodeEmail);
      
      // Decode right before the user attempts to print
      window.addEventListener('beforeprint', decodeEmail);
    });
  });
</script>
