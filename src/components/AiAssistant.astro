---
// AI Assistant Component
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
---

<div id="ai-assistant" class="ai-assistant-container">
  <button
    id="ai-assistant-toggle"
    class="ai-assistant-trigger glass"
    aria-label={isEn ? "Ask John's AI Assistant" : 'Pregunta a la IA de John'}
    title={isEn ? "Ask John's AI Assistant" : 'Pregunta a la IA de John'}
  >
    <svg
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M12 2a10 10 0 0 1 10 10c0 5.52-4.48 10-10 10S2 17.52 2 12 6.48 2 12 2z"
      ></path>
      <path d="M12 8v4"></path>
      <path d="M12 16h.01"></path>
    </svg>
    <span class="ai-badge-text">Ask AI</span>
  </button>

  <div
    id="ai-assistant-card"
    class="ai-assistant-card glass"
    aria-hidden="true"
  >
    <div class="ai-card-header">
      <div class="ai-title-wrap">
        <span class="ai-icon">🤖</span>
        <div>
          <h3 class="ai-title">
            {isEn ? "John's AI Assistant" : 'Asistente Virtual de John'}
          </h3>
          <span class="ai-status"
            >● {
              isEn ? 'Online · Live Knowledge' : 'En línea · Información al día'
            }</span
          >
        </div>
      </div>
      <button
        id="ai-card-close"
        class="ai-close-btn"
        aria-label="Close Assistant">&times;</button
      >
    </div>

    <div id="ai-messages" class="ai-messages">
      <div class="ai-msg bot">
        {
          isEn
            ? "Hi! I'm John's AI assistant. Ask me anything about his experience as Development Manager, Golang, DevSecOps, or Cloud Architecture!"
            : '¡Hola! Soy el asistente virtual de John. Pregúntame sobre su trayectoria como Gerente de Desarrollo, Golang, DevSecOps o Arquitectura Cloud.'
        }
      </div>
    </div>

    <div class="ai-quick-prompts">
      <button
        class="quick-btn"
        data-query={isEn
          ? "What is John's current role?"
          : '¿Cuál es el rol actual de John?'}
      >
        {isEn ? 'Current Role' : 'Rol Actual'}
      </button>
      <button
        class="quick-btn"
        data-query={isEn
          ? 'What is his tech stack?'
          : '¿Cuál es su stack tecnológico?'}
      >
        {isEn ? 'Tech Stack' : 'Tecnologías'}
      </button>
      <button
        class="quick-btn"
        data-query={isEn
          ? 'How many years of experience?'
          : '¿Cuántos años de experiencia tiene?'}
      >
        {isEn ? 'Experience' : 'Experiencia'}
      </button>
    </div>

    <form id="ai-form" class="ai-input-form">
      <input
        type="text"
        id="ai-input"
        class="ai-input"
        placeholder={isEn ? 'Ask a question...' : 'Escribe una pregunta...'}
        autocomplete="off"
        required
      />
      <button type="submit" class="ai-send-btn" aria-label="Send query">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
  </div>
</div>

<style>
  .ai-assistant-container {
    position: fixed;
    bottom: 5.5rem;
    right: 1.5rem;
    z-index: 900;
  }

  .ai-assistant-trigger {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 9999px;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--accent-primary, #3b82f6);
    color: var(--accent-primary, #3b82f6);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    transition: all 0.25s ease;
  }

  .ai-assistant-trigger:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 15px 30px rgba(59, 130, 246, 0.3);
  }

  .ai-assistant-card {
    position: absolute;
    bottom: 3.5rem;
    right: 0;
    width: 350px;
    max-width: 90vw;
    height: 440px;
    background: var(--card-bg, #ffffff);
    border: 1px solid var(--card-border, #e2e8f0);
    border-radius: 1.25rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
    opacity: 0;
    pointer-events: none;
    transform: translateY(15px) scale(0.95);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ai-assistant-card.active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .ai-card-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-light, #e2e8f0);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .ai-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .ai-icon {
    font-size: 1.5rem;
  }

  .ai-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
  }

  .ai-status {
    font-size: 0.75rem;
    color: #10b981;
  }

  .ai-close-btn {
    background: transparent;
    border: none;
    font-size: 1.5rem;
    color: var(--text-secondary);
    cursor: pointer;
    line-height: 1;
  }

  .ai-messages {
    flex: 1;
    padding: 1rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.88rem;
  }

  .ai-msg {
    padding: 0.75rem 1rem;
    border-radius: 1rem;
    line-height: 1.45;
    max-width: 88%;
  }

  .ai-msg.bot {
    background: var(--tag-bg, #f1f5f9);
    color: var(--text-primary);
    align-self: flex-start;
    border-bottom-left-radius: 0.2rem;
  }

  .ai-msg.user {
    background: var(--accent-primary, #3b82f6);
    color: #ffffff;
    align-self: flex-end;
    border-bottom-right-radius: 0.2rem;
  }

  .ai-quick-prompts {
    padding: 0.5rem 1rem;
    display: flex;
    gap: 0.35rem;
    overflow-x: auto;
  }

  .quick-btn {
    background: var(--tag-bg, #f1f5f9);
    border: 1px solid var(--tag-border, #cbd5e1);
    color: var(--text-secondary);
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .quick-btn:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  .ai-input-form {
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--border-light, #e2e8f0);
    display: flex;
    gap: 0.5rem;
  }

  .ai-input {
    flex: 1;
    border: 1px solid var(--card-border, #cbd5e1);
    background: var(--card-bg, #ffffff);
    color: var(--text-primary);
    padding: 0.5rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    outline: none;
  }

  .ai-send-btn {
    background: var(--accent-primary, #3b82f6);
    color: #ffffff;
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .ai-assistant-trigger:active {
    transform: scale(0.96) !important;
    transition: transform 100ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (max-width: 768px) {
    .ai-assistant-container {
      bottom: 5rem;
      right: 1rem;
    }
  }

  @media print {
    .ai-assistant-container {
      display: none !important;
    }
  }
</style>

<script>
  const initAiAssistant = () => {
    const trigger = document.getElementById('ai-assistant-toggle');
    const card = document.getElementById('ai-assistant-card');
    const closeBtn = document.getElementById('ai-card-close');
    const form = document.getElementById('ai-form') as HTMLFormElement | null;
    const input = document.getElementById(
      'ai-input'
    ) as HTMLInputElement | null;
    const messages = document.getElementById('ai-messages');
    const quickBtns = document.querySelectorAll('.quick-btn');

    if (!trigger || !card || !closeBtn || !form || !input || !messages) return;

    const toggleCard = () => {
      const isActive = card.classList.toggle('active');
      card.setAttribute('aria-hidden', (!isActive).toString());
      if (isActive) input.focus();
    };

    trigger.addEventListener('click', toggleCard);
    closeBtn.addEventListener('click', toggleCard);

    const isEn = document.documentElement.lang === 'en';

    const getAnswer = (q: string): string => {
      const query = q.toLowerCase();
      if (
        query.includes('rol') ||
        query.includes('role') ||
        query.includes('actual') ||
        query.includes('current') ||
        query.includes('gerente') ||
        query.includes('manager')
      ) {
        return isEn
          ? 'John currently serves as Development Manager (Gerente de Desarrollo), directing software engineering strategy, cloud architecture, continuous delivery, and engineering team growth.'
          : 'John se desempeña actualmente como Gerente de Desarrollo, liderando la estrategia de tecnología, arquitectura cloud, entrega continua y el crecimiento de equipos de ingeniería.';
      }
      if (
        query.includes('tech') ||
        query.includes('stack') ||
        query.includes('tecnolog') ||
        query.includes('lenguaje') ||
        query.includes('golang') ||
        query.includes('c#') ||
        query.includes('.net') ||
        query.includes('azure') ||
        query.includes('aws')
      ) {
        return isEn
          ? "John's core stack includes Golang, C#/.NET Core, Node.js (NestJS), TypeScript, React, Cloud (Azure/AWS), Terraform (IaC), DevSecOps, and Clean Architecture."
          : 'El stack principal de John incluye Golang, C#/.NET Core, Node.js (NestJS), TypeScript, React, Nube (Azure/AWS), Terraform (IaC), DevSecOps y Clean Architecture.';
      }
      if (
        query.includes('año') ||
        query.includes('year') ||
        query.includes('experiencia') ||
        query.includes('experience') ||
        query.includes('trayectoria')
      ) {
        return isEn
          ? 'John has 18+ years of experience in software engineering, technical leadership, DevSecOps, and distributed cloud architectures.'
          : 'John cuenta con más de 18 años de experiencia en ingeniería de software, liderazgo técnico, DevSecOps y arquitecturas distribuidas en la nube.';
      }
      if (
        query.includes('empresa') ||
        query.includes('compan') ||
        query.includes('quetzal') ||
        query.includes('mercado libre') ||
        query.includes('zulu') ||
        query.includes('indra')
      ) {
        return isEn
          ? 'John has held leadership and engineering roles at Quetzal (Senior Team Lead), Zulu Tech (Tech Lead B2B/Web3), Mercado Libre (Sr Software Engineer), Indra, Fuse Mobile, and Intergrupo.'
          : 'John ha desempeñado roles de liderazgo e ingeniería en Quetzal (Senior Team Lead), Zulu Tech (Tech Lead B2B/Web3), Mercado Libre (Sr Software Engineer), Indra, Fuse Mobile e Intergrupo.';
      }
      if (
        query.includes('proyecto') ||
        query.includes('project') ||
        query.includes('github') ||
        query.includes('helpers') ||
        query.includes('portfolio')
      ) {
        return isEn
          ? 'Featured projects include GitHub Helpers (Open source SVG stats generator & live API) and JATC.co (high-performance PWA portfolio with Astro 7 & Clean Architecture).'
          : 'Entre sus proyectos destacan GitHub Helpers (generador Open Source de tarjetas SVG y Live API en Node.js/TypeScript) y JATC.co (portafolio PWA de alto rendimiento con Astro 7 y Clean Architecture).';
      }
      if (
        query.includes('educacion') ||
        query.includes('education') ||
        query.includes('estudio') ||
        query.includes('grado') ||
        query.includes('degree') ||
        query.includes('universidad') ||
        query.includes('politecnico') ||
        query.includes('itm')
      ) {
        return isEn
          ? 'John holds a Specialization in Information Security from Politécnico Grancolombiano (2018-2019) and a Systems Engineering Degree from Instituto Tecnológico Metropolitano (2009-2014).'
          : 'John es Especialista en Seguridad de la Información del Politécnico Grancolombiano (2018-2019) e Ingeniero de Sistemas del Instituto Tecnológico Metropolitano (2009-2014).';
      }
      if (
        query.includes('seguridad') ||
        query.includes('security') ||
        query.includes('owasp') ||
        query.includes('devsecops') ||
        query.includes('sonar')
      ) {
        return isEn
          ? 'As a Cybersecurity Specialist, John embeds OWASP Top 10 standards, SAST/DAST (SonarCloud), threat modeling, IAM (OAuth2/JWT), and secure SDLC policies natively into development pipelines.'
          : 'Como especialista en Ciberseguridad, John integra estándares OWASP Top 10, SAST/DAST (SonarCloud), modelado de amenazas, IAM (OAuth2/JWT) y políticas de SDLC seguro nativamente en los pipelines de desarrollo.';
      }
      if (
        query.includes('idioma') ||
        query.includes('language') ||
        query.includes('ingles') ||
        query.includes('english') ||
        query.includes('b2')
      ) {
        return isEn
          ? 'John speaks Native Spanish and has Professional Working Proficiency (B2) in English.'
          : 'John es hablante Nativo de Español y cuenta con nivel de Inglés Profesional B2.';
      }
      if (
        query.includes('contact') ||
        query.includes('email') ||
        query.includes('mail') ||
        query.includes('linkedin') ||
        query.includes('telefono') ||
        query.includes('celular')
      ) {
        return isEn
          ? 'You can contact John via email at joaltoroc [at] jatc.co or connect on LinkedIn (linkedin.com/in/joaltoroc).'
          : 'Puedes contactar a John por correo electrónico en joaltoroc [at] jatc.co o en LinkedIn (linkedin.com/in/joaltoroc).';
      }
      return isEn
        ? 'John is a Development Manager & Technical Lead specializing in high-performance cloud platforms, DevSecOps, and engineering team leadership. Ask about his stack, experience, projects, or education!'
        : 'John es Gerente de Desarrollo y Technical Lead especializado en plataformas en la nube de alto rendimiento, DevSecOps y liderazgo de equipos. ¡Pregúntame sobre su stack, experiencia, proyectos o educación!';
    };

    const addMessage = (text: string, sender: 'user' | 'bot') => {
      const div = document.createElement('div');
      div.className = `ai-msg ${sender}`;
      div.textContent = text;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;

      addMessage(text, 'user');
      input.value = '';

      setTimeout(() => {
        const answer = getAnswer(text);
        addMessage(answer, 'bot');
      }, 400);
    });

    quickBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const query = btn.getAttribute('data-query');
        if (query) {
          addMessage(query, 'user');
          setTimeout(() => {
            addMessage(getAnswer(query), 'bot');
          }, 300);
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initAiAssistant);
  document.addEventListener('astro:page-load', initAiAssistant);
</script>
