---
// Skills Component
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const skillCategoriesEs = [
  {
    title: 'Seguridad & DevSecOps',
    skills: [
      'OWASP Top 10',
      'Pentesting',
      'Secure SDLC',
      'SAST/DAST (SonarCloud)',
      'Threat Modeling',
      'IAM (OAuth2/JWT)',
      'Compliance (KYC/KYB)',
    ],
  },
  {
    title: 'Arquitectura & Nube',
    skills: [
      'Cloud Architecture (Azure/AWS)',
      'Terraform (IaC)',
      'Kubernetes (K8s)',
      'Docker',
      'CI/CD (GitHub Actions / GitLab CI)',
      'Clean Architecture',
      'Event-Driven Architecture (EDA)',
    ],
  },
  {
    title: 'Desarrollo Backend',
    skills: [
      'Go (Golang)',
      'C# (.NET Core)',
      'Node.js (NestJS)',
      'Microservices',
      'REST APIs',
      'gRPC',
      'PHP',
    ],
  },
  {
    title: 'Bases de Datos & Data',
    skills: [
      'SQL Server',
      'MongoDB',
      'MySQL',
      'Redis',
      'Apache Kafka',
      'Elasticsearch',
      'BigQuery',
    ],
  },
  {
    title: 'Front-End & Mobile',
    skills: [
      'React',
      'React Native',
      'Next.js',
      'NuxtJS',
      'Vue.js',
      'Astro',
      'TypeScript',
      'Tailwind CSS',
    ],
  },
];

const skillCategoriesEn = [
  {
    title: 'Security & DevSecOps',
    skills: [
      'OWASP Top 10',
      'Pentesting',
      'Secure SDLC',
      'SAST/DAST (SonarCloud)',
      'Threat Modeling',
      'IAM (OAuth2/JWT)',
      'Compliance (KYC/KYB)',
    ],
  },
  {
    title: 'Architecture & Cloud',
    skills: [
      'Cloud Architecture (Azure/AWS)',
      'Terraform (IaC)',
      'Kubernetes (K8s)',
      'Docker',
      'CI/CD (GitHub Actions / GitLab CI)',
      'Clean Architecture',
      'Event-Driven Architecture (EDA)',
    ],
  },
  {
    title: 'Backend Development',
    skills: [
      'Go (Golang)',
      'C# (.NET Core)',
      'Node.js (NestJS)',
      'Microservices',
      'REST APIs',
      'gRPC',
      'PHP',
    ],
  },
  {
    title: 'Databases & Data',
    skills: [
      'SQL Server',
      'MongoDB',
      'MySQL',
      'Redis',
      'Apache Kafka',
      'Elasticsearch',
      'BigQuery',
    ],
  },
  {
    title: 'Front-End & Mobile',
    skills: [
      'React',
      'React Native',
      'Next.js',
      'NuxtJS',
      'Vue.js',
      'Astro',
      'TypeScript',
      'Tailwind CSS',
    ],
  },
];

const skillCategories = lang === 'en' ? skillCategoriesEn : skillCategoriesEs;
---

<section id="skills" class="skills-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t('skills.title')}</h2>
      <div class="section-line"></div>
    </div>

    <div class="skills-grid">
      {
        skillCategories.map((category) => (
          <div class="skill-category glass">
            <h3 class="category-title">{category.title}</h3>
            <div class="skills-tags">
              {category.skills.map((skill) => (
                <span
                  class="skill-tag"
                  data-skill={skill}
                  role="button"
                  tabindex="0"
                  aria-pressed="false"
                  title={
                    lang === 'en'
                      ? `Filter experience and projects by ${skill}`
                      : `Filtrar experiencias y proyectos con ${skill}`
                  }
                >
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section-header {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .section-title {
    font-size: 2.5rem;
    letter-spacing: -0.5px;
  }

  .section-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border-light), transparent);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-8);
  }

  .skill-category {
    padding: var(--space-8);
    border-radius: var(--card-radius);
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    transition: all var(--transition-normal);
  }

  .skill-category:hover {
    transform: translateY(-5px);
    border-color: var(--accent-primary);
    box-shadow: 0 10px 30px -10px rgba(37, 99, 235, 0.12);
  }

  :global(.dark) .skill-category:hover {
    box-shadow: 0 10px 30px -10px rgba(59, 130, 246, 0.25);
  }

  .category-title {
    font-size: 1.25rem;
    color: var(--text-primary);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-light);
  }

  .skills-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .skill-tag {
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    color: var(--tag-color);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-fast);
    user-select: none;
  }

  .skill-tag:hover,
  .skill-tag.active {
    background: var(--tag-hover-bg);
    border-color: var(--accent-primary);
    color: var(--text-primary);
    transform: scale(1.05);
  }

  .skill-tag.active {
    box-shadow: 0 0 12px var(--accent-primary);
  }
</style>

<script>
  const initSkillFilter = () => {
    const skillTags = document.querySelectorAll('.skill-tag');
    const expCards = document.querySelectorAll('.timeline-item');
    const projectCards = document.querySelectorAll('.project-card');

    let activeSkill: string | null = null;

    const filterAll = (skill: string | null) => {
      activeSkill = skill;

      const isEn = document.documentElement.lang === 'en';
      skillTags.forEach((tag) => {
        const isActive = Boolean(
          skill &&
          tag.getAttribute('data-skill')?.toLowerCase() === skill.toLowerCase()
        );
        tag.classList.toggle('active', isActive);
        tag.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      const announcer = document.getElementById('sr-announcer');
      if (announcer) {
        announcer.textContent = skill
          ? isEn
            ? `Filtered portfolio by ${skill}`
            : `Portafolio filtrado por ${skill}`
          : isEn
            ? 'Skill filters cleared'
            : 'Filtros de habilidades limpiados';
      }

      if (!skill) {
        expCards.forEach((card) => ((card as HTMLElement).style.opacity = '1'));
        projectCards.forEach(
          (card) => ((card as HTMLElement).style.opacity = '1')
        );
        return;
      }

      const term = skill.toLowerCase();

      expCards.forEach((card) => {
        const text = card.textContent?.toLowerCase() || '';
        (card as HTMLElement).style.opacity = text.includes(term)
          ? '1'
          : '0.25';
      });

      projectCards.forEach((card) => {
        const text = card.textContent?.toLowerCase() || '';
        (card as HTMLElement).style.opacity = text.includes(term)
          ? '1'
          : '0.25';
      });
    };

    skillTags.forEach((tag) => {
      const handleSelect = () => {
        const skill = tag.getAttribute('data-skill');
        if (!skill) return;
        if (activeSkill === skill) {
          filterAll(null);
        } else {
          filterAll(skill);
          document
            .getElementById('experience')
            ?.scrollIntoView({ behavior: 'smooth' });
        }
      };

      tag.addEventListener('click', handleSelect);
      tag.addEventListener('keydown', (e: Event) => {
        if (
          (e as KeyboardEvent).key === 'Enter' ||
          (e as KeyboardEvent).key === ' '
        ) {
          e.preventDefault();
          handleSelect();
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', initSkillFilter);
  document.addEventListener('astro:page-load', initSkillFilter);
</script>
