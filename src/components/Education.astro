---
// Education Component
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isEn = lang === 'en';

const educationListEs = [
  {
    institution: "Politécnico Grancolombiano",
    degree: "Especialización en Seguridad de la Información",
    period: "2018 - 2019"
  },
  {
    institution: "Instituto Tecnológico Metropolitano",
    degree: "Ingeniería de Sistemas",
    period: "2009 - 2014"
  },
  {
    institution: "Instituto Tecnológico Metropolitano",
    degree: "Tecnología en Sistemas de Información",
    period: "2005 - 2009"
  },
  {
    institution: "I.E. Gilberto Álzate Avendaño",
    degree: "Bachiller Técnico en Informática (Diseño de Software)",
    period: "1999 - 2004"
  }
];

const educationListEn = [
  {
    institution: "Politécnico Grancolombiano",
    degree: "Specialization in Information Security",
    period: "2018 - 2019"
  },
  {
    institution: "Instituto Tecnológico Metropolitano",
    degree: "Systems Engineering",
    period: "2009 - 2014"
  },
  {
    institution: "Instituto Tecnológico Metropolitano",
    degree: "Information Systems Technology",
    period: "2005 - 2009"
  },
  {
    institution: "I.E. Gilberto Álzate Avendaño",
    degree: "Technical High School Diploma in Computer Science (Software Design)",
    period: "1999 - 2004"
  }
];

const educationList = isEn ? educationListEn : educationListEs;
---

<section id="education" class="education-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t('education.title')}</h2>
      <div class="section-line"></div>
    </div>
    
    <div class="education-grid">
      {educationList.map(edu => (
        <div class="edu-card glass">
          <div class="icon-wrapper">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
              <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
          </div>
          <div class="edu-content">
            <h3 class="degree">{edu.degree}</h3>
            <h4 class="institution text-gradient">{edu.institution}</h4>
            <span class="period">{edu.period}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: 2.5rem;
    letter-spacing: -0.5px;
  }

  .section-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border-light), transparent);
  }

  .education-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
  }

  .edu-card {
    padding: 2.5rem;
    border-radius: 1.5rem;
    display: flex;
    gap: 1.5rem;
    transition: transform var(--transition-normal);
  }

  .edu-card:hover {
    transform: translateY(-5px);
    border-color: rgba(59, 130, 246, 0.3);
  }

  .icon-wrapper {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    border-radius: 1rem;
    background: rgba(59, 130, 246, 0.1);
    color: var(--accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .edu-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .degree {
    font-size: 1.25rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .institution {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .period {
    font-size: 0.85rem;
    color: var(--text-secondary);
    display: inline-block;
    background: var(--surface-light);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    align-self: flex-start;
  }

  @media (max-width: 768px) {
    .edu-card {
      flex-direction: column;
    }
  }
</style>
