{
  "name": "jatc",
  "description": "Personal portfolio of John Alexander Toro Cortés — Development Manager, Information Security Specialist & Technical Lead. Built with Astro 7, TypeScript, LightningCSS, strict CSP (DevSecOps), WCAG 2.2 accessibility, and PWA offline support.",
  "homepage": "https://www.jatc.co",
  "repository": {
    "type": "git",
    "url": "https://github.com/joaltoroc/jatc.co.git"
  },
  "keywords": [
    "astro",
    "typescript",
    "portfolio-website",
    "devsecops",
    "cybersecurity",
    "clean-architecture",
    "pwa",
    "wcag",
    "a11y",
    "i18n",
    "lightningcss",
    "vitest",
    "static-site",
    "owasp"
  ],
  "type": "module",
  "version": "0.7.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "prepare": "husky",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write . && eslint --fix ."
  },
  "dependencies": {
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitest/coverage-v8": "5.0.5",
    "astro-robots-txt": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "lightningcss": "1.33.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite-plugin-compression": "0.5.1",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.14.0"
}
