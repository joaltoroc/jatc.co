{
  "name": "jatc",
  "description": "Personal Portfolio of John Alexander Toro Cortés - Engineering Manager, Tech Lead & Cybersecurity Specialist. Built with Astro, TypeScript, and high-performance static rendering.",
  "type": "module",
  "version": "0.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "prepare": "husky",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write . && eslint --fix ."
  },
  "dependencies": {
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@typescript-eslint/parser": "8.71.0",
    "@vitest/coverage-v8": "5.0.3",
    "astro-robots-txt": "1.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "lightningcss": "1.33.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite-plugin-compression": "0.5.1",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
