# Redirigir errores 404 a la página de inicio
ErrorDocument 404 /

# MIME types mappings
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml font/woff2 image/svg+xml
</IfModule>

# Cache-Control optimization for production
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 year"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://stats.g.doubleclick.net https://www.google.com https://www.google.com.co; script-src 'self' 'sha256-bhfVK4HDtVucNaZirFvMpyM5AnLNj3+bWKtQAj7/3T4=' 'sha256-wYxHlCB64y9ML4rASaVx/f5y9Um7Vgq9ufrJX/SBL4c=' 'sha256-31fQF/g9KGmEnutu6M7cTHdK4cN5J5z5NRerO5mFMfQ=' 'sha256-XZ8sYIQFHnxBXHQehIU6RhTi/FJzFoLa4CBi4R7ipJY=' 'sha256-7uBJAHCuWSj9j9u+F4FDNv+CgP6sV9JaW7OGn0yxgRI=' 'sha256-JmNLu7E8lSjqN4zaZ01eFHLti006u+Oy19MzQ6cujvA=' 'sha256-2ZwZZQLnPEQO2erDXI35URPsBmvy7/M2G5o1colW6iY=' 'sha256-ygB6GSmrbQRw/SY30/kC9p/3mj3o6RHlsc1eldaH2vw=' 'sha256-caeSnnQARILHK3h+8YhrzwE9dq1b9ftNEJ0DBQqZdd8=' 'sha256-arw5M6amGWgice/FW04I0qj+JHmSu++96ez1pkNTEPY=' 'sha256-FMwFesxTHxXBE/k3tpCwT0/LbC+/4G8P57ohi3pp3/0=' 'sha256-Nwe8d+DppmOAD6ehxDgSax6tPF1sh3B9VxwRoyB+TI8=' 'sha256-6aFYg6CORg34GjQi97MJZMn47NsIHyIfa5XfIMGKF5Y=' 'sha256-Fm5NSCOszlelzGh494tPV0/1fmfHsu1hEO1c0WQ3d8s=' 'sha256-ghcVQyFCQhQiAqbnqQSvnCRf9s3NyR7G4AQEKvlVvFA=' https://www.googletagmanager.com https://static.cloudflareinsights.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.google.com https://cloudflareinsights.com; frame-ancestors 'none';"

  # Security Headers
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "DENY"
  Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"

  # Hashed assets in _astro/ (JS, CSS, Fonts, Images)
  # Cache for 1 year since hashes change when content changes
  <FilesMatch "\.(css|js|woff2|webp|png|jpg|jpeg|gif|ico|svg|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML pages
  # Cache for 0 seconds (revalidate every time)
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

