# Redirigir errores 404 a la página de inicio
ErrorDocument 404 /

# MIME types mappings
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml font/woff2 image/svg+xml
</IfModule>

# Cache-Control optimization for production
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 year"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://stats.g.doubleclick.net https://www.google.com https://www.google.com.co; script-src 'self' 'sha256-bhfVK4HDtVucNaZirFvMpyM5AnLNj3+bWKtQAj7/3T4=' 'sha256-wYxHlCB64y9ML4rASaVx/f5y9Um7Vgq9ufrJX/SBL4c=' 'sha256-mj2Jktqf4jet3ND8q7hefyTImNw+Pa9LM+Zi6dbwFTs=' 'sha256-e0GeA/LJx5qeMkIDDMCq+lzBvzHNMvMpkMOHIVC9eHw=' 'sha256-GQsRAT74z+7LnDPOBMCfznq95bYAb0P8/hqvgA/3kVQ=' 'sha256-s/XmT1hi3B0an9gNNvjPlWza6tqPvpHuONQH4HV5V7k=' 'sha256-q74VWiBAlWUWRZQYdeapCqew0tr5f+m3vcGMCkWqbJo=' 'sha256-iEK2YK0zOgfCcRcfBMDiO3tRU6HrMyXTpEsW48MXjqw=' 'sha256-gGYhQmLDPVSzzMqWypWm/4N1V3WRGsdynloJSePB0Wc=' https://www.googletagmanager.com https://static.cloudflareinsights.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.google.com https://cloudflareinsights.com; frame-ancestors 'none';"

  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "DENY"
  Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"

  # Hashed assets in _astro/ (JS, CSS, Fonts, Images)
  # Cache for 1 year since hashes change when content changes
  <FilesMatch "\.(css|js|woff2|webp|png|jpg|jpeg|gif|ico|svg|webmanifest)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML pages
  # Cache for 0 seconds (revalidate every time)
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

