# Redirigir errores 404 a la página de inicio
ErrorDocument 404 /

# MIME types mappings
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/font-woff2 .woff2
  AddType image/webp .webp
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml font/woff2 font/woff image/svg+xml
</IfModule>

# Cache-Control optimization for production
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/x-font-woff2 "access plus 1 year"
  ExpiresByType font/x-woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 year"

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/xml "access plus 0 seconds"
  ExpiresByType text/plain "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://stats.g.doubleclick.net https://www.google.com https://www.google.com.co; script-src 'self' 'sha256-31fQF/g9KGmEnutu6M7cTHdK4cN5J5z5NRerO5mFMfQ=' 'sha256-5cLdmBlyDdqM1hLnMaWRqCUKBuIVEyforg9ieylWe8A=' 'sha256-6qE4uvX+SzyAaO9MBZfuaqnejYjwg52teNNjLuMh8zw=' 'sha256-9e87km+FLNSzdjDCcmZ/MpgPuK0AO9dUMGnsFdzhJzM=' 'sha256-FMwFesxTHxXBE/k3tpCwT0/LbC+/4G8P57ohi3pp3/0=' 'sha256-MTzmlHJr0TwJ374tZYCZd9o4IUCZ+TVQc8W05ITz3sQ=' 'sha256-Nxyl0BbYAZ7FftrChNpIq/c/gDqzAhl+bwg0muInjLw=' 'sha256-Xirpji6ujJRWvlo+bUuoR9Bc6crOV4qyrO9IE3oJe40=' 'sha256-YRcgsl9mdqkAnRKHXjsgL+9cFKwLShnbVMmQj8eukk4=' 'sha256-Yc4NgcStwPJjhEX/8uDyMCn+fXmbwd5FdAaHi3a9uRU=' 'sha256-amHRZeB8QQWcU77ymun563dhPiAJijevgl0S0prG/og=' 'sha256-bhfVK4HDtVucNaZirFvMpyM5AnLNj3+bWKtQAj7/3T4=' 'sha256-ghcVQyFCQhQiAqbnqQSvnCRf9s3NyR7G4AQEKvlVvFA=' 'sha256-mWDufatLe59tsiZMmL3Hu+s9D2W+PT22MDNj4QJxzpY=' 'sha256-wYxHlCB64y9ML4rASaVx/f5y9Um7Vgq9ufrJX/SBL4c=' https://www.googletagmanager.com https://static.cloudflareinsights.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://www.google.com https://cloudflareinsights.com; frame-ancestors 'none';"

  # Security Headers
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set Cross-Origin-Opener-Policy "same-origin"
  Header set X-XSS-Protection "1; mode=block"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "DENY"
  Header set Permissions-Policy "geolocation=(), camera=(), microphone=()"

  # Hashed assets in _astro/ (JS, CSS, Fonts, Images)
  # Cache for 1 year since hashes change when content changes
  <FilesMatch "\.(css|js|woff2|woff|webp|png|jpg|jpeg|gif|ico|svg|webmanifest)$">
    Header unset Cache-Control
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML pages
  # Cache for 0 seconds (revalidate every time)
  <FilesMatch "\.(html|xml|txt)$">
    Header unset Cache-Control
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header always set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

